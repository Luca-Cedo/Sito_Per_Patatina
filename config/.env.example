# EmailJS Configuration Template

# IMPORTANTE: Non committare questo file con le chiavi reali!
# Questo è solo un template per mostrare quali variabili servono.

# Otieni questi valori da https://dashboard.emailjs.com/admin

# La tua Public Key (è pubblica, non è un segreto)
EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# Service ID (es: service_abc123def456)
EMAILJS_SERVICE_ID=YOUR_SERVICE_ID_HERE

# Template ID (es: template_xyz789uvw123)
EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE

# Email destinataria (già hardcodato nel codice, solo per riferimento)
RECIPIENT_EMAIL=pelatoesotico23@gmail.com
